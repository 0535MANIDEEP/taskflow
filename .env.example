# Copy this file to .env and fill it in. The .env file is gitignored and must
# never be committed: it holds a database password and a signing secret.

# Postgres connection string. A free database from Neon takes about two
# minutes to create and needs no card.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign the session tokens. It has to exist: the server refuses
# to start without it rather than falling back to a default, because a
# default secret is a secret anyone can read.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=3001

# Origin allowed to call the API from a browser. Left blank in development,
# which allows any origin, and set to the deployed front end URL in production.
CORS_ORIGIN=
